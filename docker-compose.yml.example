# منصة مديرية التخطيط والإحصاء
#   التشغيل:            docker compose up -d --build
#   بعد تعديل .env:      docker compose restart medsp
#   بعد بيانات شهر جديد: docker compose up -d --build

# Copy docker-compose.yml.example to docker-compose.yml and edit extra_host

services:
  medsp:
    build: .
    container_name: medsp
    restart: unless-stopped
    env_file: .env
    ports:
      - "127.0.0.1:3000:3000"   # متاح لـ Nginx على السيرفر فقط، لا من الشبكة مباشرة
    environment:
      PORT: "3000"

    extra_hosts:
      - "sub-domain.example.com:ip proxy server" # edit info for subdomain && ip proxy

    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:3000/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
