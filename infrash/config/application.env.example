# Copy outside Git, chmod 600, and fill with the REAL environment-specific URL
# reachable both by the app container and users' browsers over your VPN/network.
# The values below are placeholders, not the user's discovered server settings.
SUPABASE_URL=http://REPLACE_WITH_SUPABASE_PRIVATE_IP:8000
SUPABASE_KEY=REPLACE_WITH_PUBLIC_ANON_OR_PUBLISHABLE_KEY
PORT=3000

# Admin push notifications on data updates (optional). Generate once on the server:
#   node server/push-keys.mjs   (also works inside the app container)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:planning@example.gov.sy
# PUSH_SECRET=
