# ─────────────────────────────────────────────────────────────
#  إعدادات منصة مديرية التخطيط والإحصاء
#  انسخ هذا الملف باسم .env ثم ضع القيم الفعلية:
#      cp .env.example .env
#  بعد أي تعديل: أعد تشغيل الخدمة فقط (لا حاجة لإعادة البناء)
#      docker compose restart medsp
# ─────────────────────────────────────────────────────────────

# عنوان Supabase على سيرفر الوزارة (عنوان Kong / API Gateway)
SUPABASE_URL=https://db.example.gov.sy

# المفتاح العلني (ANON_KEY من إعدادات Supabase المستضاف ذاتياً)
# ⚠️ لا تضع هنا SERVICE_ROLE_KEY أبداً — الخادم يرفض التشغيل إن وُضع.
SUPABASE_KEY=

# المنفذ الذي يستمع عليه خادم المنصة (Nginx يحوّل إليه)
PORT=3000

# (اختياري) مجلد البيانات المحمية — الافتراضي server-data داخل المشروع
# MEDSP_DATA_DIR=/app/server-data
